# ==============================================================================
# Neuron OS — Environment Variables Example
# Duplicate this file as .env.local for local development.
# Configure all required variables in Vercel Project Settings -> Environment Variables.
# ==============================================================================

# Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter (Optional Fallback)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Upstash Redis / Background Job Queue (Optional for local worker)
REDIS_URL=redis://default:your-token@your-redis-host:6379
WORKER_CONCURRENCY=5
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_DELAY_MS=2000

# Vercel Cron Secret (Secures /api/cron/* endpoints)
CRON_SECRET=your-random-cron-secret-token

# Render/External Worker URL for keepalive ping (Optional)
RENDER_WORKER_URL=https://your-worker.onrender.com
